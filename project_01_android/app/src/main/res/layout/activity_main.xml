<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".MainActivity">

    <!-- Main content: vertical LinearLayout with weighted distribution -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Video player. Hidden in lobby — only shown during an active session. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/player_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:visibility="gone">

            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/safe_blue"
                android:contentDescription="Video player"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Section labels. Default hidden — the cold-start screen is the innocuous
             player-facing start screen (only JOIN + the invisible GM hotspots).
             showStartScreen()/showPrepareScreen()/showGame() toggle these at runtime. -->
        <LinearLayout
            android:id="@+id/section_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Players"
                android:textColor="@color/blue_200"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Playlist"
                android:textColor="@color/blue_200"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lists: players + videos side by side. Default hidden (see section_labels). -->
        <LinearLayout
            android:id="@+id/lists_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/player_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                tools:listitem="@layout/item_player" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="4dp"
                android:background="#33FFFFFF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/video_playlist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                tools:listitem="@layout/item_video" />
        </LinearLayout>

        <!-- Bottom button bar -->
        <LinearLayout
            android:id="@+id/button_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <!-- Game master tools row. Default hidden; shown only in prepare mode. -->
            <LinearLayout
                android:id="@+id/gm_tools_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/add_video_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Add a video to the playlist"
                    android:text="+ Video"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/turn_off_screen_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Turn off player screens"
                    android:text="Screen"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/deactivate_torch_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Toggle player flashlights"
                    android:text="Torch"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Saved playlists row. Default hidden; shown only in prepare mode. -->
            <LinearLayout
                android:id="@+id/saved_playlists_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/save_playlist_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Save current playlist with a name"
                    android:text="Save List"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/load_playlist_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Load a saved playlist"
                    android:text="Load List"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Session controls row. On the start screen this holds ONLY the visible
                 JOIN button — CREATE is the invisible create_hotspot (undercover). -->
            <LinearLayout
                android:id="@+id/session_controls_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/join_game_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Join an existing game session"
                    android:text="Join Game"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Prepare-mode row: set the prepared game's password and save/exit.
                 Default hidden; shown only in prepare mode (invisible PREPARE hotspot). -->
            <LinearLayout
                android:id="@+id/prepare_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/prepare_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:autofillHints="password"
                    android:hint="Password"
                    android:inputType="text"
                    android:textColor="@android:color/white"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/prepare_save_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Save this prepared game"
                    android:text="Save"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/prepare_done_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Exit prepare mode"
                    android:text="Done"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connection status -->
        <TextView
            android:id="@+id/connectivity_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:contentDescription="Connection status"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:text="Disconnected" />

    </LinearLayout>

    <!-- Full-screen black overlay for turn-off-screen command -->
    <FrameLayout
        android:id="@+id/black_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Invisible tap target for game master (double-tap toggles GM controls,
         long-press confirms End Game). Sized to a ~20mm-radius patch in the centre
         of the screen so the GM has to deliberately reach the middle — accidental
         long-presses elsewhere don't end the session. -->
    <View
        android:id="@+id/invisible_resume_button"
        android:layout_width="40mm"
        android:layout_height="40mm"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:contentDescription="Double-tap for game controls"
        android:visibility="gone" />

    <!-- Invisible GM hotspots on the start screen. Undercover: transparent, no
         contentDescription, importantForAccessibility=no so TalkBack stays silent.
         Default VISIBLE so they work on a cold start (isGameStarted never emits at
         launch, so show*() may not have run); showGame()/showPrepareScreen() hide them.
         PREPARE = long-press top-left; CREATE = double-tap top-right (opposite corners,
         clear of the centered Join button, gesture-guarded against accidental taps). -->
    <View
        android:id="@+id/prepare_hotspot"
        android:layout_width="40mm"
        android:layout_height="40mm"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/create_hotspot"
        android:layout_width="40mm"
        android:layout_height="40mm"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:importantForAccessibility="no" />

    <!-- Game master controls overlay: undercover by design.
         Three minimal buttons (Prev / Play-Next / Light), revealed by double-tap on
         invisible_resume_button. End Game lives on a long-press of the same target. -->
    <LinearLayout
        android:id="@+id/gm_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/gm_previous_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Previous video"
                android:scaleType="centerInside"
                android:src="@drawable/ic_skip_previous_overlay" />

            <ImageButton
                android:id="@+id/gm_next_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Play or next video"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play_arrow_overlay" />

            <ImageButton
                android:id="@+id/gm_light_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Toggle lights"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lightbulb_outline_overlay" />
        </LinearLayout>

        <!-- Thin strip below the icon row that reveals the player status / playlist
             panel. It carries connection + battery info for each player, so the GM
             needs it during a session even though the playback controls themselves
             stay minimal. -->
        <Button
            android:id="@+id/gm_playlist_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:contentDescription="Show or hide playlist"
            android:text="•"
            android:textColor="#50FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Error banner at the top -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone"
        app:cardBackgroundColor="#D32F2F"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/error_banner_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/error_banner_action"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/error_banner_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dismiss"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
