<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".MainActivity">

    <!-- Main content: vertical LinearLayout with weighted distribution -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Video player. Hidden in lobby — only shown during an active session. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/player_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:visibility="gone">

            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/safe_blue"
                android:contentDescription="Video player"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Prepare-mode title. Shown only in prepare mode (the player list is hidden
             there, so this replaces the "Players | Playlist" column labels). -->
        <TextView
            android:id="@+id/prepare_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="Prepare game"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Lists: players + videos side by side (in-game roster view). In prepare mode
             the player column + divider are hidden so the playlist spans full width. -->
        <LinearLayout
            android:id="@+id/lists_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/player_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                tools:listitem="@layout/item_player" />

            <View
                android:id="@+id/lists_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="4dp"
                android:background="#33FFFFFF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/video_playlist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                tools:listitem="@layout/item_video" />
        </LinearLayout>

        <!-- Bottom button bar (prepare mode only now: + Video and the password/save row).
             Default hidden; the player-facing start screen uses the centred join_panel below. -->
        <LinearLayout
            android:id="@+id/button_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <!-- Game master tools row (prepare mode only): add videos to the playlist. -->
            <LinearLayout
                android:id="@+id/gm_tools_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_video_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="12dp"
                    android:contentDescription="Add a video to the playlist"
                    android:text="Add video"
                    android:textColor="@android:color/white"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white"
                    app:strokeColor="#66FFFFFF" />
            </LinearLayout>

            <!-- Prepare-mode row: set the prepared game's password and save/exit.
                 Default hidden; shown only in prepare mode (invisible PREPARE hotspot). -->
            <LinearLayout
                android:id="@+id/prepare_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/prepare_password_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    app:boxStrokeColor="@color/blue_200"
                    app:hintTextColor="@color/blue_200">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/prepare_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@android:color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Actions: Done (dismissive, text) + Save game (primary, filled). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/prepare_done_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Exit prepare mode"
                        android:text="Done"
                        android:textColor="@color/blue_200" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/prepare_save_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Save this prepared game"
                        android:text="Save game"
                        app:backgroundTint="@color/blue_500" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Connection status -->
        <TextView
            android:id="@+id/connectivity_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:contentDescription="Connection status"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:text="Disconnected" />

    </LinearLayout>

    <!-- Player-facing start screen: a single centred JOIN action. Kept in the centre
         (not the top) so it never overlaps the top-corner GM hotspots, which consume
         touches. Default VISIBLE = the cold-start screen; hidden in prepare/game. -->
    <LinearLayout
        android:id="@+id/join_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join_game_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Join a game"
            android:minWidth="200dp"
            android:paddingVertical="14dp"
            android:text="Join Game"
            android:textSize="16sp"
            app:cornerRadius="28dp" />
    </LinearLayout>

    <!-- Full-screen black overlay for turn-off-screen command -->
    <FrameLayout
        android:id="@+id/black_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Invisible tap target for game master (double-tap toggles GM controls,
         long-press confirms End Game). Sized to a ~20mm-radius patch in the centre
         of the screen so the GM has to deliberately reach the middle — accidental
         long-presses elsewhere don't end the session. -->
    <View
        android:id="@+id/invisible_resume_button"
        android:layout_width="40mm"
        android:layout_height="40mm"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:contentDescription="Double-tap for game controls"
        android:visibility="gone" />

    <!-- Invisible GM hotspots on the start screen. Undercover: transparent, no
         contentDescription, importantForAccessibility=no so TalkBack stays silent.
         Default VISIBLE so they work on a cold start (isGameStarted never emits at
         launch, so show*() may not have run); showGame()/showPrepareScreen() hide them.
         PREPARE = long-press top-left; CREATE = double-tap top-right (opposite corners,
         clear of the centered Join button, gesture-guarded against accidental taps). -->
    <View
        android:id="@+id/prepare_hotspot"
        android:layout_width="40mm"
        android:layout_height="40mm"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/create_hotspot"
        android:layout_width="40mm"
        android:layout_height="40mm"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:importantForAccessibility="no" />

    <!-- Game master controls overlay: undercover by design.
         Three minimal buttons (Prev / Play-Next / Light), revealed by double-tap on
         invisible_resume_button. End Game lives on a long-press of the same target. -->
    <LinearLayout
        android:id="@+id/gm_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/gm_previous_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Previous video"
                android:scaleType="centerInside"
                android:src="@drawable/ic_skip_previous_overlay" />

            <ImageButton
                android:id="@+id/gm_next_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Play or next video"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play_arrow_overlay" />

            <ImageButton
                android:id="@+id/gm_light_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Toggle lights"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lightbulb_outline_overlay" />
        </LinearLayout>

        <!-- Thin strip below the icon row that reveals the player status / playlist
             panel. It carries connection + battery info for each player, so the GM
             needs it during a session even though the playback controls themselves
             stay minimal. -->
        <Button
            android:id="@+id/gm_playlist_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:contentDescription="Show or hide playlist"
            android:text="•"
            android:textColor="#50FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Error banner at the top -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone"
        app:cardBackgroundColor="#D32F2F"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/error_banner_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/error_banner_action"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/error_banner_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dismiss"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
